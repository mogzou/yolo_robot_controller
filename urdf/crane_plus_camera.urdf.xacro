<?xml version="1.0"?>
<robot name="crane_plus_camera" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- カメラリンクの作成 -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.03 0.03" />
      </geometry>
      <material name="Black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 第1関節（crane_plus_link1）の上にカメラを固定するジョイント -->
  <joint name="camera_joint" type="fixed">
    <!-- 第1関節から少し前・上を向く位置（x=0.08m, z=0.15m）に配置 -->
    <origin xyz="0.08 0 0.15" rpy="0 0.35 0" />
    <parent link="crane_plus_link1" />
    <child link="camera_link" />
  </joint>

  <!-- Gazebo (Ignition) 用のカメラセンサプラグイン記述 -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>