<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="crane_plus">
  <!-- CRANE+ V2 本体の標準記述をインクルード -->
  <xacro:include filename="$(find crane_plus_description)/urdf/crane_plus.urdf.xacro" />
  
  <!-- 先ほど作成したカスタムカメラ記述をインクルード -->
  <xacro:include filename="$(find yolo_robot_controller)/urdf/crane_plus_camera.urdf.xacro" />
</robot>